---
import '../styles/global.css';
import '../styles/tournaments.css';
import data from '../data/site.json';
import ExternalLink from '../components/ExternalLink.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
// Pages pass their own title; the home page uses "Science Olympiad at Illinois | SOIL".
// noindex pages (the 404 page) tell search engines to skip them and carry no canonical address.
const {page='home',eventPage=false,title=data.name,description=data.seo.home,structuredData,noindex=false}=Astro.props;
const top=eventPage?'event-top':'main';
const canonical=new URL(Astro.url.pathname,Astro.site);

// Each nav entry is its own page; Home is the site root.
const nav=[['Home','home'],['About','about'],['Community','community'],['Tournaments','tournaments'],['Join','join'],['Contact','contact']];
const pageUrl=(id:string)=>id==='home'?`${base}/`:`${base}/${id}/`;
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#022954"/>{noindex?<meta name="robots" content="noindex"/>:<link rel="canonical" href={canonical}/>}<link rel="icon" type="image/png" href={`${base}/favicon.png?v=white-1`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:site_name" content={data.name}/>{!noindex&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={new URL(`${base}/logo.png`,Astro.site)}/><meta property="og:image:alt" content="SOIL club atom emblem in navy and orange"/><meta name="twitter:card" content="summary"/><link rel="sitemap" href={`${base}/sitemap-index.xml`}/>{structuredData&&<script type="application/ld+json" set:html={JSON.stringify(structuredData)}/>}<link rel="preload" href={`${base}/fonts/Geist-Variable.woff2`} as="font" type="font/woff2" crossorigin="anonymous"/><style is:inline set:html={`@font-face{font-family:Geist;src:url("${base}/fonts/Geist-Variable.woff2") format("woff2");font-style:normal;font-weight:100 900;font-display:swap}`}/></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="container nav-shell"><a class="brand" href={pageUrl('home')} aria-label="Science Olympiad at Illinois home"><img src={`${base}/logo.svg`} width="48" height="48" alt="SOIL club logo"/><span>Science Olympiad<span class="brand-second">at Illinois</span></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation"><span>Menu</span><span aria-hidden="true">☰</span></button><nav id="navigation" aria-label="Main navigation">{nav.map(([label,id])=><a href={pageUrl(id)} aria-current={id===page?'page':undefined}>{label}</a>)}</nav></div></header>
<main id="main" tabindex="-1"><slot/></main>
<footer><div class="container"><div class="footer-top"><div><a class="brand" href={pageUrl('home')}><img src={`${base}/logo.svg`} alt="SOIL club logo" width="60" height="60" loading="lazy"/><span>Science Olympiad<span class="brand-second">at Illinois</span></span></a><picture class="official-logo"><source srcset={`${base}/logos/science-olympiad.svg`} type="image/svg+xml"/><img src={`${base}/logos/science-olympiad.png`} alt="Science Olympiad logo" width="704" height="440" loading="lazy"/></picture></div><nav aria-label="Footer navigation"><h2>Explore</h2>{nav.map(([label,id])=><a href={pageUrl(id)}>{label}</a>)}</nav><div><h2>Join</h2><div class="footer-icons">{data.joinLinks.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.button} for Science Olympiad at Illinois (opens in a new tab)`} title={link.title}><img src={`${base}/icons/${link.icon}.svg`} alt="" aria-hidden="true" width="24" height="24" loading="lazy"/></a>)}</div></div><div class="footer-resources"><h2>Resources</h2>{data.links.map(link=><ExternalLink href={link.url}>{link.label}</ExternalLink>)}</div></div><div class="footer-legal"><div class="footer-legal-grid"><address class="footer-address">{data.address.map((line,i)=>i===0?<strong>{line}</strong>:<span>{line}</span>)}{data.email&&<a href={`mailto:${data.email}`}>{data.email}</a>}</address><div class="footer-notices"><p>Science Olympiad at Illinois is a Registered Student Organization at the University of Illinois Urbana-Champaign. It is an independent student organization and does not speak on behalf of the university.</p><p>Science Olympiad at Illinois is an official alumni chapter registered with Science Olympiad, Inc. Science Olympiad and the Science Olympiad logo are trademarks of Science Olympiad, Inc.</p></div></div><div class="footer-bottom"><span>{data.name} ({data.shortName}), <span class="footer-aka">{data.nickname}</span></span><a href={`#${top}`}>Back to top ↑</a></div></div></div></footer>
<a class="back-to-top" href={`#${top}`} aria-label="Back to top">↑</a>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav=document.querySelector<HTMLElement>('#navigation');
const closeMenu=()=>{toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('is-open')};
toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open)});
nav?.querySelectorAll<HTMLAnchorElement>('a').forEach(link=>link.addEventListener('click',closeMenu));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){closeMenu();toggle.focus()}});
const desktop=matchMedia('(min-width: 901px)');desktop.addEventListener('change',e=>{if(e.matches)closeMenu()});
// Scroll spy only runs for the invitational page's in-page sub-navigation.
const sections=[...document.querySelectorAll<HTMLElement>('[data-event-section]')];
const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-event-link]')];
let scheduled=false;
function updateActive(){const offset=(document.querySelector('.site-header')?.getBoundingClientRect().height??84)+(document.querySelector('.event-nav')?.getBoundingClientRect().height??0)+40;let current=sections[0]?.id;for(const section of sections){if(section.getBoundingClientRect().top<=offset)current=section.id}if(window.innerHeight+window.scrollY>=document.documentElement.scrollHeight-4)current=sections.at(-1)?.id;for(const link of links){if(link.dataset.eventLink===current)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current')}scheduled=false}
if(links.length){window.addEventListener('scroll',()=>{if(!scheduled){scheduled=true;requestAnimationFrame(updateActive)}},{passive:true});window.addEventListener('resize',updateActive);window.addEventListener('hashchange',updateActive);updateActive()}
// Native anchors retain URL hashes and work without JavaScript.
</script>
</body></html>

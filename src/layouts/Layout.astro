---
import '../styles/global.css';
import '../styles/redesign.css';
import data from '../data/site.json';
const { title, description = 'Turn curiosity into community. Help support Science Olympiad competitions, mentor local teams, and grow with Science Olympiad at Illinois.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path='') => `${base}/${path}${path ? '/' : ''}`;
const nav = [['About','about'],['What We Do','what-we-do'],['Events','events'],['Team','team'],['Alumni & Network','alumni'],['Contact','contact']];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#022954"/><title>{title ? `${title} | ${data.name}` : data.name}</title><link rel="canonical" href={canonical}/><link rel="icon" type="image/png" href={`${base}/favicon.png`}/><meta property="og:title" content={title ? `${title} | ${data.name}` : data.name}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(`${base}/logo.png`, Astro.site)}/><meta property="og:image:alt" content="SOIL club atom emblem in navy and orange"/><meta name="twitter:card" content="summary"/></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="container nav-shell"><a class="brand" href={url()} aria-label="Science Olympiad at Illinois home"><img src={`${base}/logo.png`} width="54" height="54" alt="SOIL club logo"/><span>Science Olympiad<span class="brand-second">at Illinois</span></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">☰</span></button><nav id="navigation" aria-label="Main navigation">{nav.map(([label,path])=><a href={url(path)} aria-current={Astro.url.pathname.replace(/\/$/,'')===`${base}/${path}`?'page':undefined}>{label}</a>)}<a class="button button-small" href={url('get-involved')}>Get Involved <span aria-hidden="true">↗</span></a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="container"><div class="footer-top"><div><a class="brand" href={url()}><img src={`${base}/logo.png`} alt="SOIL club logo" width="60" height="60" loading="lazy"/><span>Science Olympiad<span class="brand-second">at Illinois</span></span></a><p class="footer-tagline">A little curiosity. A lasting impact.</p></div><div><p class="eyebrow">EXPLORE</p><a href={url('about')}>About SOIL</a><a href={url('what-we-do')}>What We Do</a><a href={url('events')}>Events</a></div><div><p class="eyebrow">CONNECT</p><a href={url('get-involved')}>Get Involved</a><a href={url('alumni')}>Alumni & Network</a><a href={url('contact')}>Contact</a>{data.socials.map(s=><a href={s.url}>{s.label}</a>)}<span class="muted small">[TODO: social links]</span></div></div><div class="footer-legal"><p>Science Olympiad at Illinois is a Registered Student Organization at the University of Illinois Urbana-Champaign. It is an independent student organization and does not speak on behalf of the university.</p><p>Science Olympiad and the Science Olympiad logo are trademarks of Science Olympiad, Inc. This is not an official Science Olympiad, Inc. website.</p><details class="brand-slot"><summary>Official logo slot · pending membership confirmation</summary><p>[TODO: add the official Science Olympiad logo alongside the SOIL logo after membership confirmation. Confirm trademark notice wording.]</p></details><div class="footer-bottom"><span>Science Olympiad at Illinois · Student-led. Curiosity-driven.</span><a href={url('legal')}>Legal & Credits ↗</a></div></div></div></footer>
<script>const button=document.querySelector('.menu-toggle');const nav=document.querySelector('#navigation');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open)});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&button?.getAttribute('aria-expanded')==='true'){button.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');button.focus()}});</script>
</body></html>

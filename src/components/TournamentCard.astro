---
import TournamentDate from './TournamentDate.astro';
import {display,description,hasValue,externalUrl} from '../lib/tournaments.mjs';
const {tournament,compact=false}=Astro.props;
const registration=tournament.registration??{};
const registrationUrl=externalUrl(registration.url);
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<article class:list={['tournament-entry',{'tournament-compact':compact}]}>
  <div class="tournament-card">
    <div class="tournament-copy">
      <h3>{display(tournament.name)}</h3>
      <p>{description(tournament)}</p>
      <div class="tournament-actions">
        {tournament.id==='2027-soil-invitational'&&<a class="button" href={`${base}/invitational/`}>Invitational Details</a>}
        {registrationUrl?<a class="button button-outline" href={registrationUrl} target="_blank" rel="noopener noreferrer" aria-label={`Register your team for ${display(tournament.name)} (opens in a new tab)`}>Register Your Team ↗</a>:<button class="button tournament-disabled" type="button" disabled aria-disabled="true">Registration opens soon</button>}
      </div>
    </div>
    <div class="tournament-facts"><dl>
      <div><dt>Date</dt><dd><TournamentDate value={tournament.date}/></dd></div>
      <div><dt>Location</dt><dd>{display(tournament.location)}</dd></div>
      <div><dt>Divisions</dt><dd>{display(tournament.divisions)}</dd></div>
      <div><dt>Teams</dt><dd>{display(tournament.teamCap)}</dd></div>
      <div><dt>Registration</dt><dd>{hasValue(registration.opens)||hasValue(registration.closes)?<><span>Opens: <TournamentDate value={registration.opens}/></span><span>Closes: <TournamentDate value={registration.closes}/></span></>:'To be announced'}</dd></div>
      <div><dt>Fee</dt><dd>{display(tournament.fee)}</dd></div>
    </dl></div>
  </div>
  <p class="tournament-contact">Tournament questions? {hasValue(tournament.contactEmail)?<a class="text-link" href={`mailto:${tournament.contactEmail}`}>{tournament.contactEmail}</a>:<a class="text-link" href="#contact">Contact Science Olympiad at Illinois</a>}</p>
</article>

---
import TournamentInfo from './TournamentInfo.astro';
import TournamentDate from './TournamentDate.astro';
import ExternalLink from './ExternalLink.astro';
import {display,description,hasValue,externalUrl} from '../lib/tournaments.mjs';
const {tournament,compact=false}=Astro.props;
const registration=tournament.registration??{};
const registrationUrl=externalUrl(registration.url);
const interestFormUrl=externalUrl(tournament.interestFormUrl);
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<article class:list={['tournament-entry',{'tournament-compact':compact}]}>
  <div class="tournament-card">
    <div class="tournament-copy">
      <h3>{display(tournament.name)}</h3>
      <p class="tournament-date"><TournamentDate value={tournament.date} endValue={tournament.dateEnd} emptyLabel="Date to be announced"/></p>
      <p class="tournament-description">{description(tournament)}</p>
      <TournamentInfo label="Divisions" value={tournament.divisions}/>
      <div class="tournament-actions">
        {tournament.id==='2027-soil-invitational'&&<a class="button tournament-primary" href={`${base}/invitational/`}>Invitational Details <span aria-hidden="true">→</span></a>}
        {registrationUrl ? (
          <a class="button button-outline" href={registrationUrl} target="_blank" rel="noopener noreferrer" aria-label={`Register your team for ${display(tournament.name)} (opens in a new tab)`}>Register Your Team ↗</a>
        ) : interestFormUrl ? (
          <ExternalLink class="button tournament-interest" href={interestFormUrl} aria-describedby={`${tournament.id}-interest-note`}>Interest Form</ExternalLink>
        ) : (
          <button class="button button-outline tournament-disabled" type="button" disabled aria-disabled="true">Registration opens soon</button>
        )}
      </div>
      {!registrationUrl && interestFormUrl && (
        <p class="tournament-interest-note" id={`${tournament.id}-interest-note`}>Registration opens soon. This form is for interest only.</p>
      )}
    </div>
  </div>
  <p class="tournament-contact">Tournament questions? {hasValue(tournament.contactEmail)?<a class="text-link" href={`mailto:${tournament.contactEmail}`}>{tournament.contactEmail}</a>:<a class="text-link" href={`${base}/contact/`}>Contact Science Olympiad at Illinois</a>}</p>
</article>

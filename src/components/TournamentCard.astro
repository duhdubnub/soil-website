---
import TournamentDate from './TournamentDate.astro';
import {display,description,hasValue,externalUrl,eventSchema,serializeSchema} from '../lib/tournaments.mjs';
const {tournament,compact=false}=Astro.props;
const registration=tournament.registration??{};
const registrationUrl=externalUrl(registration.url);
const volunteerUrl=externalUrl(tournament.volunteerUrl);
const events=(tournament.events??[]).filter(hasValue);
const schedule=tournament.schedule??[];
const schema=eventSchema(tournament);
---
<article class:list={['tournament-entry',{'tournament-compact':compact}]}>
  <div class="tournament-card">
    <div class="tournament-copy">
      <h3>{display(tournament.name)}</h3>
      <p>{description(tournament)}</p>
      <div class="tournament-actions">
        {registrationUrl?<a class="button" href={registrationUrl} target="_blank" rel="noopener noreferrer" aria-label={`Register your team for ${display(tournament.name)} (opens in a new tab)`}>Register Your Team ↗</a>:<button class="button tournament-disabled" type="button" disabled aria-disabled="true">Registration opens soon</button>}
        {volunteerUrl&&<a class="button button-outline" href={volunteerUrl} target="_blank" rel="noopener noreferrer" aria-label={`Volunteer for ${display(tournament.name)} (opens in a new tab)`}>Volunteer ↗</a>}
      </div>
    </div>
    <div class="tournament-facts"><dl>
      <div><dt>Date</dt><dd><TournamentDate value={tournament.date}/></dd></div>
      <div><dt>Location</dt><dd>{display(tournament.location)}</dd></div>
      <div><dt>Divisions</dt><dd>{display(tournament.divisions)}</dd></div>
      <div><dt>Teams</dt><dd>{display(tournament.teamCap)}</dd></div>
      <div><dt>Registration</dt><dd>{hasValue(registration.opens)||hasValue(registration.closes)?<><span>Opens: <TournamentDate value={registration.opens}/></span><span>Closes: <TournamentDate value={registration.closes}/></span></>:'To be announced'}</dd></div>
      <div><dt>Fee</dt><dd>{display(tournament.fee)}</dd></div>
    </dl></div>
  </div>
  <div class="tournament-details">
    <div><h4>Events</h4>{events.length?<ul>{events.map(event=><li>{display(event)}</li>)}</ul>:<p>Event list to be announced</p>}</div>
    <div><h4>Schedule</h4>{schedule.length?<ol class="tournament-timeline">{schedule.map(item=><li><span>{hasValue(item.time)&&/^([01]\d|2[0-3]):[0-5]\d$/.test(item.time)?<time datetime={item.time}>{item.time}</time>:display(null)}</span><span>{display(item.title)}</span></li>)}</ol>:<p>Schedule to be announced</p>}</div>
  </div>
  <p class="tournament-contact">Tournament questions? {hasValue(tournament.contactEmail)?<a class="text-link" href={`mailto:${tournament.contactEmail}`}>{tournament.contactEmail}</a>:<a class="text-link" href="#contact">Contact Science Olympiad at Illinois</a>}</p>
  {schema&&<script type="application/ld+json" set:html={serializeSchema(schema)}/>}
</article>

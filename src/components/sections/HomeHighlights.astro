---
import site from '../../data/site.json';
import data from '../../data/tournaments.json';
import ExternalLink from '../ExternalLink.astro';
import {display,description,externalUrl} from '../../lib/tournaments.mjs';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const tournament=data.tournaments.find(t=>t.featured)??data.tournaments[0];
const registrationUrl=externalUrl(tournament.registration?.url);
---
<section id="highlights" class="section tint" aria-label="Highlights"><div class="container highlight-grid"><article class="highlight-card"><h2>Community Impact</h2><p>{site.communityImpact}</p><a class="button" href={`${base}/community/`}>Learn More <span aria-hidden="true">→</span></a></article><article class="highlight-card"><h2>{display(tournament.name)}</h2><p>{description(tournament)}</p>{registrationUrl ? <ExternalLink class="button" href={registrationUrl}>Register on Scilympiad</ExternalLink> : <a class="button" href={`${base}/tournaments/`}>Tournament Info <span aria-hidden="true">→</span></a>}</article></div></section>

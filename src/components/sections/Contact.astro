---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="contact" class="section" aria-labelledby="contact-title" tabindex="-1"><div class="container contact-page"><h1 id="contact-title" class="page-title">Contact</h1>{data.email&&<p class="contact-lead">For all inquiries, please email us at <a class="text-link" href={`mailto:${data.email}`}>{data.email}</a>. Email is the preferred way to reach Science Olympiad at Illinois.</p>}<div class="contact-officers"><p>Need to reach a specific officer instead?</p><a class="button button-outline button-small" href={`${base}/about/#team`}>Find an officer <span aria-hidden="true">→</span></a></div></div></section>

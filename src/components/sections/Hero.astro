---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="home" class="hero" aria-labelledby="home-title" tabindex="-1"><div class="orbital-field" aria-hidden="true"><span></span><span></span><i></i></div><div class="container hero-content"><img class="hero-logo" src={`${base}/logo.svg`} width="220" height="220" alt="SOIL club atom emblem" fetchpriority="high"/><h1 id="home-title">Science Olympiad<br/><span>at Illinois</span></h1><p class="hero-mission">{data.mission}</p><div class="hero-actions"><a class="button" href={`${base}/join/`}>Join the Club <span aria-hidden="true">↗</span></a><a class="button button-outline" href={`${base}/about/`}>Learn More <span aria-hidden="true">→</span></a></div></div></section>

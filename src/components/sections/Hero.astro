---
import data from '../../data/site.json';
import OrbitalField from '../OrbitalField.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="home" class="hero" aria-labelledby="home-title" tabindex="-1"><OrbitalField/><div class="container hero-content"><img class="hero-logo" src={`${base}/logo.svg`} width="220" height="220" alt="SOIL club atom emblem" fetchpriority="high"/><h1 id="home-title">Science Olympiad<br/><span>at Illinois</span></h1><p class="hero-intro">{data.intro}<span class="hero-est">Est. {data.established}</span></p><div class="hero-actions"><a class="button" href={`${base}/about/`}>About Us <span aria-hidden="true">→</span></a></div><div class="hero-join"><p class="hero-mission">{data.mission}</p><a class="button button-orange" href={`${base}/join/`}>Join the Club <span aria-hidden="true">→</span></a></div><a class="scroll-cue" href="#highlights"><span aria-hidden="true">↓</span>Scroll for more information</a></div></section>

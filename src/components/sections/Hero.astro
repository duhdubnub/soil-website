---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="home" class="hero" aria-labelledby="home-title" tabindex="-1"><div class="orbital-field" aria-hidden="true"><span></span><span></span><i></i></div><div class="container hero-grid"><div><p class="eyebrow">STUDENT-LED · CURIOSITY-DRIVEN</p><h1 id="home-title">Science Olympiad<br/><span>at Illinois</span></h1><p class="hero-mission">{data.mission}</p><div class="hero-actions"><a class="button" href="#join">Join the Club <span aria-hidden="true">↗</span></a><a class="button button-outline" href="#about">Learn More <span aria-hidden="true">↓</span></a></div></div><div class="hero-emblem"><p class="eyebrow">SCIENCE. SERVICE. CONNECTION.</p><div class="emblem-frame"><img src={`${base}/logo.webp`} width="400" height="400" alt="SOIL atom emblem with a flask, gear, DNA, planet, leaf, and mountain" fetchpriority="high"/></div><p class="emblem-caption">A COMMUNITY IN MOTION</p></div></div><div class="container hero-bottom"><span>AT THE UNIVERSITY OF ILLINOIS URBANA-CHAMPAIGN</span><a href="#about">Explore SOIL ↓</a></div></section>

---
import data from '../../data/site.json';
---
<section id="about" class="section" aria-labelledby="about-title" tabindex="-1"><div class="container"><div class="mission-grid reveal"><div><p class="eyebrow">01 / ABOUT & WHAT WE DO</p><h2 id="about-title">A love of science.<br/>A reason to give back.</h2></div><p class="lead">{data.mission}</p></div><div class="about-columns reveal"><div><h3>What is Science Olympiad?</h3><p>{data.about.science}</p></div><div><h3>Who we are</h3><p>{data.about.identity}</p></div><div><h3>Our story</h3><p>{data.about.story}</p><p class="todo">{data.about.historyTodo}</p></div></div><div class="activity-grid reveal">{data.activities.map(a=><article class="activity-card"><span class="card-number">{a.icon}</span><p class="eyebrow">{a.tag}</p><h3>{a.title}</h3><p>{a.description}</p></article>)}</div></div></section>

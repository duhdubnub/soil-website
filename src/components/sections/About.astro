---
import data from '../../data/site.json';
---
<section id="about" class="section" aria-labelledby="about-title" tabindex="-1"><div class="container"><div class="mission-grid reveal"><h2 id="about-title">About & What We Do</h2><p class="lead">{data.mission}</p></div><div class="about-columns reveal"><div><h3>What is Science Olympiad?</h3><p>{data.about.science}</p></div><div><h3>Who we are</h3><p>{data.about.identity}</p></div><div><h3>Our story</h3><p>{data.about.story}</p><p class="todo">{data.about.historyTodo}</p></div></div><div class="activity-grid reveal">{data.activities.map(a=><article class="activity-card"><h3>{a.title}</h3><p>{a.description}</p></article>)}</div><div class="resource-row reveal">{data.links.map(link=><a class="text-link" href={link.url}>{link.label} ↗</a>)}</div></div></section>

---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const initials=(name:string)=>name.split(/\s+/).map(part=>part[0]).join('').slice(0,2).toUpperCase();
---
<div id="team" class="about-team" aria-labelledby="team-title" role="region" tabindex="-1"><div class="section-heading"><div><h2 id="team-title">Team</h2></div></div><div class="team-grid officer-grid">{data.officers.map(officer=><article class="officer-card">{officer.photo?<img class="officer-photo" src={officer.photo.startsWith('/')?`${base}${officer.photo}`:officer.photo} width="400" height="500" alt={officer.name} loading="lazy"/>:<div class="photo-placeholder" aria-hidden="true"><span>{initials(officer.name)}</span></div>}<div class="officer-text"><h3>{officer.name}</h3><p class="officer-role">{officer.role}</p>{(officer.favoriteEvent||officer.favoriteMemory)&&<dl class="officer-facts">{officer.favoriteEvent&&<div><dt>Favorite Event</dt><dd>{officer.favoriteEvent}</dd></div>}{officer.favoriteMemory&&<div><dt>Favorite Science Olympiad Memory</dt><dd>{officer.favoriteMemory}</dd></div>}</dl>}{officer.email&&<a class="officer-email" href={`mailto:${officer.email}`}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>{officer.email}</span></a>}</div></article>)}</div></div>

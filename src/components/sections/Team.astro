---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="team" class="section tint" aria-labelledby="team-title" tabindex="-1"><div class="container"><div class="section-heading reveal"><div><p class="eyebrow">02 / THE PEOPLE BEHIND SOIL</p><h2 id="team-title">Meet the team.</h2></div><p>Student leadership. Shared purpose.<br/>Officer details will be added once confirmed.</p></div><div class="team-grid reveal">{data.officers.map(officer=><article class="officer-card">{officer.photo?<img class="officer-photo" src={officer.photo.startsWith('/')?`${base}${officer.photo}`:officer.photo} width="400" height="400" alt={officer.name} loading="lazy"/>:<div class="photo-placeholder"><span aria-hidden="true">＋</span><p>[TODO: consented officer photo]</p></div>}<div class="officer-text"><h3>{officer.name}</h3><p>{officer.role}</p>{officer.email&&<a href={`mailto:${officer.email}`}>Email officer ↗</a>}</div></article>)}</div><p class="todo">[TODO: complete officer roster; confirm consent for photos and optional published emails.]</p></div></section>

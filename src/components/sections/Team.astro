---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const initials=(name:string)=>name.split(/\s+/).map(part=>part[0]).join('').slice(0,2).toUpperCase();
---
<div id="team" class="about-team" aria-labelledby="team-title" role="region" tabindex="-1"><div class="section-heading"><div><h2 id="team-title">Team</h2></div></div><div class="team-grid officer-grid">{data.officers.map(officer=><article class="officer-card">{officer.photo?<img class="officer-photo" src={officer.photo.startsWith('/')?`${base}${officer.photo}`:officer.photo} width="400" height="300" alt={officer.name} loading="lazy"/>:<div class="photo-placeholder" aria-hidden="true"><span>{initials(officer.name)}</span></div>}<div class="officer-text"><h3>{officer.name}</h3><p class="officer-role">{officer.role}</p>{(officer.favoriteEvent||officer.favoriteMemory)&&<dl class="officer-facts">{officer.favoriteEvent&&<div><dt>Favorite Event</dt><dd>{officer.favoriteEvent}</dd></div>}{officer.favoriteMemory&&<div><dt>Favorite Science Olympiad Memory</dt><dd>{officer.favoriteMemory}</dd></div>}</dl>}{officer.email&&<a href={`mailto:${officer.email}`}>Email officer ↗</a>}</div></article>)}</div><p class="todo">[TODO: consented officer photos; optional published emails.]</p></div>

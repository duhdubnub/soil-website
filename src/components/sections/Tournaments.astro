---
import data from '../../data/tournaments.json';
import TournamentCard from '../TournamentCard.astro';
const featured=data.tournaments.filter(t=>t.featured);
const others=data.tournaments.filter(t=>!t.featured);
---
<section id="tournaments" class="section tint" aria-labelledby="tournaments-title" tabindex="-1"><div class="container"><div class="section-heading reveal"><div><h2 id="tournaments-title">Tournaments</h2></div><p>Explore the SOIL Invitational and its latest details.</p></div>{featured.map(tournament=><div class="reveal"><TournamentCard tournament={tournament}/></div>)}{others.length>0&&<div class="tournament-grid reveal">{others.map(tournament=><TournamentCard tournament={tournament} compact/>)}</div>}</div></section>

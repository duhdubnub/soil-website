---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const gallery:{src:string,alt:string,caption?:string}[]=data.gallery;
---
<section id="community" class="section" aria-labelledby="community-title" tabindex="-1"><div class="container"><div class="community-heading"><h1 id="community-title" class="page-title">Community</h1><p>{data.communityIntro}</p></div><div class="highlight-grid">{data.communityCards.map(card=><article class="highlight-card"><h2>{card.title}</h2><p>{card.description}{card.contactEmail&&<Fragment>{' '}{data.email?<a class="text-link" href={`mailto:${data.email}`}>{data.email}</a>:<a class="text-link" href={`${base}/contact/`}>our Contact page</a>}.</Fragment>}</p></article>)}</div>{gallery.length>0&&<div id="gallery" class="community-gallery" aria-labelledby="gallery-title" role="region" tabindex="-1"><h2 id="gallery-title">Gallery</h2><div class="gallery-grid">{gallery.map(photo=><figure><img src={photo.src.startsWith('/')?`${base}${photo.src}`:photo.src} alt={photo.alt} loading="lazy"/>{photo.caption&&<figcaption>{photo.caption}</figcaption>}</figure>)}</div></div>}</div></section>

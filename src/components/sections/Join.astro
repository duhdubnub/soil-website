---
import data from '../../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="join" class="section navy" aria-labelledby="join-title" tabindex="-1"><div class="container"><div class="join-heading"><h1 id="join-title" class="page-title">Get Involved</h1><p>Sign up, connect with the club, and follow along.</p></div><div class="join-cards">{data.joinLinks.map(link=><article class:list={['join-card',{'join-card-primary':link.primary}]}><img class="join-icon" src={`${base}/icons/${link.icon}.svg`} width="40" height="40" alt="" aria-hidden="true" loading="lazy"/><h3>{link.title}</h3><p>{link.description}</p><a class="button" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.button} for Science Olympiad at Illinois (opens in a new tab)`}>{link.button}<span aria-hidden="true">↗</span></a></article>)}</div></div></section>

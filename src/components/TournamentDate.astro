---
import { dateRangeLabel, dateValue, fallback } from '../lib/tournaments.mjs';
const { value, endValue, emptyLabel = fallback } = Astro.props;
const date = dateValue(value);
const range = dateRangeLabel(date, dateValue(endValue));
---
{range ?? (date ? <time datetime={date.iso}>{date.label}</time> : emptyLabel)}

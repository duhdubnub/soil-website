---
import Layout from '../layouts/Layout.astro';
import Join from '../components/Join.astro';
import Events from '../components/Events.astro';
import data from '../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Layout><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="orange-dot"></span> SCIENCE OLYMPIAD AT ILLINOIS</p><h1>Curiosity brought<br/>you here.<br/><span>Community</span><br/>takes you further.</h1><p class="mission">{data.mission}</p><div class="hero-actions"><a class="button" href={`${base}/get-involved/`}>Join the Club <span aria-hidden="true">↗</span></a><a class="button button-outline" href={`${base}/events/`}>See Events <span aria-hidden="true">→</span></a></div><p class="hero-note"><span aria-hidden="true">✳</span> Student-led. Science-powered. Community-minded.</p></div><div class="hero-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="orbit-dot dot-one"></span><span class="orbit-dot dot-two"></span><div class="art-label label-top">EXPLORE. CONNECT. GIVE BACK.</div><div class="logo-disc"><img src={`${base}/logo.webp`} alt="SOIL atom emblem with a flask, gear, DNA, planet, leaf, and mountain" width="480" height="480" fetchpriority="high"/></div><div class="art-label label-bottom"><span class="orange-dot"></span> A SHARED LOVE OF SCIENCE</div><span class="art-coordinate" aria-hidden="true">SOIL / COMMUNITY IN MOTION</span></div></div><div class="hero-rule container"><span>BUILT ON CURIOSITY. GROWN THROUGH SERVICE.</span><a href="#our-work">Discover what we do <span aria-hidden="true">↓</span></a></div></section>
<section id="our-work" class="section container"><div class="section-heading"><div><p class="eyebrow">PUT YOUR PASSION INTO PRACTICE</p><h2>More than a competition.<br/>A way to give back.</h2></div><a class="text-link" href={`${base}/what-we-do/`}>Explore our work <span aria-hidden="true">↗</span></a></div><div class="activity-grid">{data.activities.map((a,i)=><a class="activity-card" href={`${base}/${i===3?'alumni':'what-we-do'}/#${i===3?'network':`activity-${i+1}`}`}><div class="card-top"><span class="card-number">{a.icon}</span><span aria-hidden="true">↗</span></div><p class="micro-label">{a.tag}</p><h3>{a.title}</h3><p>{a.description}</p></a>)}</div></section>
<section class="impact"><div class="container impact-inner"><div><p class="eyebrow">SMALL ACTIONS. REAL IMPACT.</p><h2>Growing together.</h2><p class="small">[TODO: verified impact totals]</p></div>{data.stats.map(s=><div class="stat"><span>{s.value}</span><p>{s.label}</p></div>)}</div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">NEXT ON THE CALENDAR</p><h2>Find your next thing.</h2></div><a class="text-link" href={`${base}/events/`}>All events <span aria-hidden="true">↗</span></a></div><Events/></section><Join/></Layout>

---
import Layout from '../layouts/Layout.astro';
import Join from '../components/Join.astro';
import Events from '../components/Events.astro';
import data from '../data/site.json';
export function getStaticPaths(){return ['about','what-we-do','events','get-involved','team','alumni','contact','legal'].map(page=>({params:{page}}))}
const {page}=Astro.params;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const headings={about:['ABOUT SOIL','A shared love of science.','A community built around curiosity, service, and the next generation of STEM.'],'what-we-do':['OUR WORK','Put curiosity to work.','Help make Science Olympiad meaningful for students, coaches, and the people behind every competition.'],events:['MEET. LEARN. GIVE BACK.','Make room for discovery.','Find upcoming meetings and ways to support Science Olympiad. Confirmed details will appear here.'],'get-involved':['GET INVOLVED','Your next chapter starts here.','Bring your curiosity and find a way to contribute.'],team:['THE PEOPLE BEHIND SOIL','Meet the team.','Student leadership, shared purpose. Officer details will be published once confirmed.'],alumni:['ALUMNI & NETWORK','Keep the connection alive.','Science Olympiad can be the beginning of a lifelong connection to STEM and service.'],contact:['SAY HELLO','Let’s connect.','Interested in joining, mentoring, or working together? Find the right way to reach SOIL.'],legal:['LEGAL & CREDITS','Built with care.','Our independent status, trademark notices, and the assets behind this website.']};
const [eyebrow,title,description]=headings[page];
---
<Layout title={page==='about'?'About':page==='legal'?'Legal & Credits':title} description={description}><section class="page-hero"><div class="container"><a class="breadcrumb" href={`${base}/`}>Home <span aria-hidden="true">/</span></a><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p></div></section><div class="container page-content">
{page==='about'&&<><section class="editorial"><h2>Our mission</h2><p class="lead">{data.mission}</p></section><section class="two-column"><div><p class="eyebrow">THE BIG PICTURE</p><h2>What is Science Olympiad?</h2><p>Science Olympiad brings students together to explore science and engineering through team-based academic competition. Events combine scientific knowledge, problem-solving, and hands-on skills.</p><a class="text-link" href="https://www.soinc.org/">Explore national Science Olympiad ↗</a></div><div><p class="eyebrow">OUR PART IN IT</p><h2>Students supporting students.</h2><p>SOIL helps support regional and state competitions, exam writing and proctoring, mentoring, and outreach. Members can put their STEM knowledge into practice while developing volunteer skills.</p><p>Science Olympiad at Illinois is an independent Registered Student Organization at the University of Illinois Urbana-Champaign.</p></div></section><section class="editorial"><h2>Our story</h2><p>A shared interest in Science Olympiad connects our community. Our verified founding story and milestones will be added here.</p><p class="todo">[TODO: founding history and verified milestones]</p></section><section class="reserved-logo"><img src={`${base}/logo.png`} width="100" height="100" alt="SOIL club logo"/><div><h3>Official Science Olympiad logo slot</h3><p>[TODO: confirm membership status before adding an unaltered official Science Olympiad logo alongside our club logo.]</p></div></section></>}
{page==='what-we-do'&&<><div class="work-list">{data.activities.map((a,i)=><section class="work-item" id={`activity-${i+1}`}><span class="work-number">{a.icon}</span><div><p class="eyebrow">{a.tag}</p><h2>{a.title}</h2><p>{a.detail}</p></div></section>)}</div><section class="editorial"><h2>Build skills that travel with you.</h2><p>Practice scientific communication, teamwork, event organization, and mentoring. Work with others, explain complex ideas clearly, and learn how preparation becomes a positive experience for students.</p><p>SOIL helps run and supports tournaments; this website does not claim sanctioned host or official chapter status.</p></section></>}
{page==='events'&&<><section><h2>Upcoming events & meetings</h2><p class="section-intro">Check confirmed event details before making plans.</p><Events/><div class="notice"><h3>Regular meetings</h3><p>{data.meeting}</p></div></section><section class="section"><h2>Past events</h2><Events past/></section></>}
{page==='get-involved'&&<><div class="steps"><section><span class="card-number">01</span><h2>Introduce yourself.</h2><p>Share your interests so the club can help you find a way to contribute.</p>{data.signupUrl?<a class="button" href={data.signupUrl}>Open sign-up form ↗</a>:<div class="notice"><strong>Sign-up link coming soon</strong><p class="todo">[TODO: external sign-up form URL]</p></div>}</section><section><span class="card-number">02</span><h2>Come to a meeting.</h2><p>Learn about upcoming opportunities and connect with other members.</p><p class="todo">{data.meeting}</p><a class="text-link" href={`${base}/events/`}>See events →</a></section><section><span class="card-number">03</span><h2>Find your contribution.</h2><p>Help with competition logistics, write and proctor exams, or support local teams. Opportunities depend on organizer needs and confirmed arrangements.</p><a class="text-link" href={`${base}/what-we-do/`}>Explore volunteer activities →</a></section></div><section class="editorial"><h2>Start with what sparks your curiosity.</h2><p>You might love explaining biology, solving an engineering problem, or making an event run smoothly. Explore the club’s activities and ask how your interests can contribute.</p><p class="todo">[TODO: confirm joining requirements, volunteer onboarding, and any eligibility restrictions]</p></section></>}
{page==='team'&&<><div class="team-grid">{data.officers.map(officer=><article class="officer-card">{officer.photo?<img src={officer.photo.startsWith('/')?`${base}${officer.photo}`:officer.photo} alt={officer.name} width="400" height="400"/>:<div class="photo-placeholder"><span aria-hidden="true">＋</span><p>[TODO: consented officer photo]</p></div>}<div class="officer-text"><h2>{officer.name}</h2><p>{officer.role}</p>{officer.email&&<a href={`mailto:${officer.email}`}>Email officer ↗</a>}</div></article>)}</div><p class="todo">[TODO: complete officer roster; optional officer emails require approval for publication]</p></>}
{page==='alumni'&&<><section id="network" class="two-column"><div><p class="eyebrow">PASS IT FORWARD</p><h2>Your experience can make a difference.</h2><p>Stay connected to Science Olympiad by sharing your perspective, supporting mentoring, or exploring volunteer opportunities with SOIL.</p><a class="button" href={`${base}/contact/`}>Connect with SOIL ↗</a></div><div><p class="eyebrow">FOR TEACHERS & COACHES</p><h2>Let’s support curious students.</h2><p>Illinois educators and local team coaches can connect with the club about potential mentoring and competition support. Arrangements are confirmed individually.</p><p class="todo">[TODO: confirmed alumni and educator connection process]</p></div></section><section class="editorial"><h2>Explore the wider community.</h2><p>Find official information and resources directly from national and state organizations.</p><div class="resource-links">{data.links.map(link=><a href={link.url}>{link.label}<span aria-hidden="true">↗</span></a>)}</div></section></>}
{page==='contact'&&<div class="two-column"><section><h2>Reach the club</h2><p>For membership, volunteering, mentoring, and general questions.</p>{data.email?<a class="text-link" href={`mailto:${data.email}`}>{data.email}</a>:<div class="notice"><strong>Club email pending confirmation</strong><p class="todo">[TODO: public club email]</p></div>}<h3>Follow along</h3>{data.socials.length?data.socials.map(s=><p><a href={s.url}>{s.label} ↗</a></p>):<p class="todo">[TODO: verified social profile links]</p>}</section><section><h2>Find your starting point.</h2><div class="resource-links"><a href={`${base}/get-involved/`}>Join the club <span>↗</span></a><a href={`${base}/events/`}>Explore events <span>↗</span></a><a href={`${base}/alumni/`}>Alumni & educator connections <span>↗</span></a></div><p class="muted">This static website does not collect contact submissions. An external sign-up form will be linked once approved.</p></section></div>}
{page==='legal'&&<div class="legal-copy"><section><h2>Independent student organization</h2><p>Science Olympiad at Illinois is a Registered Student Organization at the University of Illinois Urbana-Champaign. It is an independent student organization and does not speak on behalf of the university.</p></section><section><h2>Science Olympiad trademarks</h2><p>Science Olympiad and the Science Olympiad logo are trademarks of Science Olympiad, Inc. This is not an official Science Olympiad, Inc. website.</p><p class="todo">[TODO: confirm exact trademark notice wording and membership status.]</p><p>No official Science Olympiad logo is displayed. Reserved slots on the About page and in the footer remain pending membership confirmation. An approved logo must be unaltered, undistorted, and displayed alongside the club logo.</p><a href="https://www.soinc.org/sites/default/files/uploaded_files/Brand_Guidelines.pdf">Science Olympiad brand guidelines ↗</a></section><section><h2>Assets & licenses</h2><ul><li>SOIL club logo: supplied by the club through the project attachment; rights reserved by its owner. Not covered by the code license. [TODO: confirm ownership and usage rights.]</li><li>Favicon and WebP logo: resized or compressed derivatives of the supplied club logo; same rights as the original.</li><li>Orbital decorations and layout: original website code, MIT license.</li><li>Typography: system font stack; no font files are distributed.</li><li>No third-party photos, stock images, icon packages, or official university marks are used.</li><li>Astro and Tailwind CSS: MIT-licensed build dependencies; their transitive dependencies retain their respective licenses.</li></ul><p>Website source code is MIT licensed. The license excludes the club logo, any future photos, and all trademarks.</p></section><section><h2>Photos, resources & privacy</h2><p>Photos of people will be posted only with their consent. Officer photo areas are labeled placeholders until approved images are supplied.</p><p>Rules manuals, event rules, and tests are not reproduced. Visit the official organizations for their resources.</p><p>No analytics, cookies, or submission storage are implemented by this site. External websites and future external forms have their own privacy policies.</p></section><section><h2>Open publication items</h2><p class="todo">[TODO: confirm image rights and photo consent; membership and official logo permission; exact trademark wording; any sanctioned hosting or chapter claims before making them.]</p></section></div>}
</div>{!['legal','get-involved'].includes(page)&&<Join/>}</Layout>

---
import Layout from '../layouts/Layout.astro';
import TournamentInfo from '../components/TournamentInfo.astro';
import TournamentDate from '../components/TournamentDate.astro';
import data from '../data/tournaments.json';
import {display,description,hasValue,externalUrl} from '../lib/tournaments.mjs';
import '../styles/invitational.css';
const t=data.tournaments.find(t=>t.id==='2027-soil-invitational')!;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const registration=t.registration??{};
const registrationUrl=externalUrl(registration.url);
const platformUrl=externalUrl(t.platformUrl);
const volunteerUrl=externalUrl(t.volunteerUrl);
const updates=[...(t.updates??[])].sort((a,b)=>String(b.date??'').localeCompare(String(a.date??'')));
const team=t.team??[];
const events=(t.events??[]).filter(hasValue);
const schedule=t.schedule??[];
const sections=[['About','about'],['Registration','registration'],['Events','events'],['Schedule','schedule'],...(updates.length?[['Updates','updates']]:[]),...(volunteerUrl?[['Volunteer','volunteer']]:[]),...(team.length?[['Team','team']]:[]),['Contact','contact']];
---
<Layout eventPage page="tournaments" title={`${display(t.name)} | Science Olympiad at Illinois`} description={description(t)}>
  <div id="event-top" class="event-header container">
    <a class="text-link" href={`${base}/tournaments/`}>← Back to Tournaments</a>
    <div class="event-title"><img src={`${base}/logo.webp`} alt="SOIL club logo" width="120" height="120"/><h1>{display(t.name)}</h1></div>
    <dl class="event-banner"><div><dt>Date</dt><dd><TournamentDate value={t.date}/></dd></div><div><dt>Format</dt><dd>{display(t.format)}</dd></div></dl>
  </div>
  <nav class="event-nav" aria-label="Invitational navigation"><div class="container">{sections.map(([label,id])=><a href={`#${id}`} data-event-link={id} aria-current={id==='about'?'location':undefined}>{label}</a>)}</div></nav>
  <div class="event-content container">
    <section id="about" data-event-section tabindex="-1" aria-labelledby="about-title"><h2 id="about-title">About</h2><p>{description(t)}</p>{(t.aboutParagraphs??[]).filter(hasValue).map(p=><p>{p}</p>)}
      <h3>Key facts</h3>
      <TournamentInfo label="Date"><TournamentDate value={t.date}/></TournamentInfo>
      <TournamentInfo label="Divisions" value={t.divisions}/>
      <TournamentInfo label="Teams" value={t.teamCap}/>
      <TournamentInfo label="Fee" value={t.fee}/>
    </section>
    <section id="registration" data-event-section tabindex="-1" aria-labelledby="registration-title"><h2 id="registration-title">Registration</h2><div class="tournament-actions">{registrationUrl?<a class="button" href={registrationUrl}>Register Your Team ↗</a>:<button class="button tournament-disabled" disabled aria-disabled="true">Registration opens soon</button>}{platformUrl&&<a class="button button-outline" href={platformUrl}>Tournament platform ↗</a>}</div></section>
    <section id="events" data-event-section tabindex="-1" aria-labelledby="events-title"><h2 id="events-title">Events</h2>{events.length?<ul>{events.map(event=><li>{event}</li>)}</ul>:<p>Event list to be announced</p>}</section>
    <section id="schedule" data-event-section tabindex="-1" aria-labelledby="schedule-title"><h2 id="schedule-title">Schedule</h2>{schedule.length?<ol class="tournament-timeline">{schedule.map(item=><li><span>{hasValue(item.time)&&/^([01]\d|2[0-3]):[0-5]\d$/.test(item.time)?<time datetime={item.time}>{item.time}</time>:display(null)}</span><span>{display(item.title)}</span></li>)}</ol>:<p>Schedule to be announced</p>}</section>
    {updates.length>0&&<section id="updates" data-event-section tabindex="-1" aria-labelledby="updates-title"><h2 id="updates-title">Updates</h2>{updates.map(update=><article class="event-update"><h3>{display(update.title)}</h3><p><TournamentDate value={update.date}/></p><p>{display(update.body)}</p></article>)}</section>}
    {volunteerUrl&&<section id="volunteer" data-event-section tabindex="-1" aria-labelledby="volunteer-title"><h2 id="volunteer-title">Volunteer</h2><p>Help bring the invitational to life as an event supervisor, test writer, or general volunteer.</p><a class="button" href={volunteerUrl}>Volunteer ↗</a></section>}
    {team.length>0&&<section id="team" data-event-section tabindex="-1" aria-labelledby="team-title"><h2 id="team-title">Tournament Team</h2><div class="team-grid">{team.map(member=><article class="officer-card officer-text"><h3>{display(member.name)}</h3><p>{display(member.role)}</p></article>)}</div></section>}
    <section id="contact" data-event-section tabindex="-1" aria-labelledby="contact-title"><h2 id="contact-title">Contact</h2><p>Tournament questions? {hasValue(t.contactEmail)?<a class="text-link" href={`mailto:${t.contactEmail}`}>{t.contactEmail}</a>:<a class="text-link" href={`${base}/contact/`}>Contact Science Olympiad at Illinois</a>}</p></section>
  </div>
</Layout>

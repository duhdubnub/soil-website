---
// GitHub Pages serves this file (built as /404.html) for any address on the site that doesn't exist.
import Layout from '../layouts/Layout.astro';
import OrbitalField from '../components/OrbitalField.astro';
import data from '../data/site.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const pages=[['About','about'],['Community','community'],['Tournaments','tournaments'],['Join','join'],['Contact','contact']];
---
<Layout page="404" title="Page Not Found | Science Olympiad at Illinois" description={data.seo.notFound} noindex><section id="not-found" class="hero not-found" aria-labelledby="not-found-title" tabindex="-1"><OrbitalField/><div class="container hero-content"><div class="not-found-code" aria-hidden="true"><span>4</span><img src={`${base}/logo.svg`} width="160" height="160" alt=""/><span>4</span></div><h1 id="not-found-title">Page not found</h1><p class="hero-mission">This page drifted out of orbit. The link may be mistyped, or the page may have moved.</p><div class="hero-actions"><a class="button" href={`${base}/`}>Back to Home <span aria-hidden="true">→</span></a><a class="button button-outline" href={`${base}/contact/`}>Contact Us</a></div><nav class="not-found-links" aria-label="Other pages">{pages.map(([label,id])=><a href={`${base}/${id}/`}>{label}</a>)}</nav></div></section></Layout>
